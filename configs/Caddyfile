# Documentation note only — this Caddyfile is not actively deployed.
# TLS cert regenerated on 2026-05-16; SAN updated to IP: <BRIDGED-IP> (bridged adapter),
# replacing the old NAT IP. Self-signed cert generated via openssl with the updated SAN.

:443 {
	tls /etc/caddy/cert.pem /etc/caddy/key.pem
	reverse_proxy localhost:8501
}

:80 {
	redir https://{host}{uri} permanent
}
